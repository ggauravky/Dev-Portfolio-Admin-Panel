# Backend Environment Variables
# Copy this file to .env for local development
# For production, set these in Render dashboard

PORT=5000
PORTFOLIO_MONGODB_URI=
PORTFOLIO_DB_NAME=test
# Legacy alternative. Use a URI with an explicit database path, or set PORTFOLIO_DB_NAME.
MONGO_URI=
# Read-only credential for portfolio_chat. Required to enable AI data.
CHAT_MONGODB_URI=
# DNS_SERVERS=
# DB_CONNECT_TIMEOUT_MS=5000
# DB_POOL_SIZE=8
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Separate credential scoped to admin_sessions, admin_auth_limits and admin_security_audit.
ADMIN_MONGODB_URI=
# Defaults to PORTFOLIO_DB_NAME. Leave unset to store security in test.
# ADMIN_DB_NAME=
# Required in production. Set the same server-only value on Render and Vercel.
ADMIN_PROXY_SECRET=
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_MAX_HOURS=12
# ADMIN_AUDIT_RETENTION_DAYS=90

# IMPORTANT: Set this to your Vercel frontend URL for production
# Example: https://ggauravkyadmin.vercel.app
FRONTEND_URL=http://localhost:3000
# ADMIN_ALLOWED_ORIGINS=
# TRUST_PROXY_HOPS=0

NODE_ENV=development
READ_ONLY_MODE=true
