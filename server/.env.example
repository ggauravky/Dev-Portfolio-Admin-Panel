# Admin API (Render). Copy to server/.env for local development.
# The Admin only reads the existing Portfolio data. It never writes to MongoDB.

# Existing Portfolio connection (cluster0). The database defaults to "test" (or the path in the URI).
# The same connection also reads the chatbot database "portfolio_chat".
MONGO_URI=
# Optional: only if the chatbot data must be read with a separate credential.
# CHAT_MONGODB_URI=
# Optional: override the business database name (defaults to the URI path, then "test").
# PORTFOLIO_DB_NAME=test

# Administrator sign-in.
ADMIN_EMAIL=
# Preferred: Argon2id hash from `npm run auth:credential`. If unset, ADMIN_PASSWORD is used.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=
# Session signing secret (at least 32 characters). JWT_SECRET is accepted as the existing name.
JWT_SECRET=
# ADMIN_SESSION_SECRET=
# ADMIN_SESSION_MAX_HOURS=8

# Required in production. Set the same 64-hex value on Render and on Vercel (server-only).
ADMIN_PROXY_SECRET=

# The Vercel origin that is allowed to call this API.
FRONTEND_URL=http://localhost:3000
# ADMIN_ALLOWED_ORIGINS=
NODE_ENV=development
# PORT=5000
# TRUST_PROXY_HOPS=0
# DNS_SERVERS=
# DB_CONNECT_TIMEOUT_MS=5000
# DB_POOL_SIZE=8
