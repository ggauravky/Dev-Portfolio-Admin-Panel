# Backend Environment Variables
# Copy this file to .env for local development
# For production, set these in Render dashboard

PORT=5000
PORTFOLIO_MONGODB_URI=
PORTFOLIO_DB_NAME=
# Legacy alternative. Use a URI with an explicit database path, or set PORTFOLIO_DB_NAME.
MONGO_URI=
# Optional separate read-only credential for portfolio_chat.
CHAT_MONGODB_URI=
# DNS_SERVERS=
# DB_CONNECT_TIMEOUT_MS=5000
# DB_POOL_SIZE=8
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IMPORTANT: Set this to your Vercel frontend URL for production
# Example: https://ggauravkyadmin.vercel.app
FRONTEND_URL=http://localhost:5173
# ADMIN_ALLOWED_ORIGINS=
# TRUST_PROXY_HOPS=0

NODE_ENV=development
READ_ONLY_MODE=false
