# Frontend Environment Variables
# Copy this file to .env.local for local development
# For production, set these in Vercel dashboard

# Browser requests always use the same-origin /api/admin path.
# Local backend uses port 5000. To override: set ADMIN_DEV_PORT in the Vite process.
# Production Vercel Function environment (server-only):
# ADMIN_API_UPSTREAM=
# ADMIN_PROXY_SECRET=
