{
    "rewrites": [
        {
            "source": "/api/admin/:path*",
            "destination": "/api/admin-proxy?__admin_path=:path*"
        },
        {
            "source": "/admin/:path*",
            "destination": "/index.html"
        }
    ],
    "functions": { "api/admin-proxy.js": { "maxDuration": 20 } },
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; connect-src 'self'" },
                { "key": "Referrer-Policy", "value": "no-referrer" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
            ]
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite"
}
